root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,md,markdown,proto,toml,yaml,yml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
